From 9e43136d6c55b385b7e76b809a3bfa8e02dd69e9 Mon Sep 17 00:00:00 2001
From: ndefrance <ndefrance@users.noreply.github.com>
Date: Sun, 1 Nov 2026 15:07:50 -0800
Subject: [PATCH 4/8] Against the Darkness: add the two whole-line variants (25
 of 25, poe2db)

"Allocated Small Passive Skills in Radius grant nothing" and "Grants all bonuses of Unallocated
Small Passive Skills in Radius" have no nodeType and were skipped by the generator. Appended
after the sorted list so existing variant indices do not move.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 src/Data/Uniques/Special/Generated.lua | 10 +++++++++-
 1 file changed, 9 insertions(+), 1 deletion(-)

diff --git a/src/Data/Uniques/Special/Generated.lua b/src/Data/Uniques/Special/Generated.lua
index f1806fb..921d455 100644
--- a/src/Data/Uniques/Special/Generated.lua
+++ b/src/Data/Uniques/Special/Generated.lua
@@ -22,6 +22,12 @@ do
 		end
 	end
 	table.sort(againstMods, function(a, b) return a.name < b.name end)
+	-- the two whole-line variants (no nodeType) go last so the existing variant indices stay stable
+	for _, modName in ipairs({ "UniqueJewelRadiusAllocatedNonNotablesGrantNothing", "UniqueJewelRadiusGrantStatsFromNonNotables" }) do
+		if uniqueMods[modName] then
+			table.insert(againstMods, { mod = uniqueMods[modName], name = modName:match("^UniqueJewelRadius(.+)$"):gsub("([a-z])([A-Z])", "%1 %2") })
+		end
+	end
 	local against = {
 		"Against the Darkness",
 		"Time-Lost Diamond",
@@ -40,7 +46,9 @@ do
 	local smallLine = "Small Passive Skills in Radius also grant "
 	local notableLine = "Notable Passive Skills in Radius also grant "
 	for index, mod in ipairs(againstMods) do
-		if mod.mod.nodeType == 1 then
+		if not mod.mod.nodeType then
+			table.insert(against, "{variant:" .. index .. "," .. variantCount .. "}" .. mod.mod[1])
+		elseif mod.mod.nodeType == 1 then
 			table.insert(against, "{variant:" .. index .. "," .. variantCount .. "}" .. smallLine .. mod.mod[1])
 		else
 			table.insert(against, "{variant:" .. index .. "," .. variantCount .. "}" .. notableLine .. mod.mod[1])
-- 
2.55.0.windows.5


