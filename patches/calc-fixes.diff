From 8c88b75711d6623bcbce2e2631d4fdc970f295ca Mon Sep 17 00:00:00 2001
From: ndefrance <ndefrance@users.noreply.github.com>
Date: Sun, 1 Nov 2026 14:57:40 -0800
Subject: [PATCH 1/8] Ghost Dance: Shroud interval/uptime output and an option
 to average the ES regeneration over constant Hits

Shroud interval = base_cooldown_modifiable_repeat_interval_ms with Cooldown Recovery
(cooldown_recovery_modifiers_also_apply_to_repeat_interval); each Shroud is lost on the
next Hit and the regeneration lasts for Recently (4 s), so uptime = min(1, 4 s / interval).

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 src/Modules/CalcPerform.lua   | 8 ++++++++
 src/Modules/ConfigOptions.lua | 4 ++++
 2 files changed, 12 insertions(+)

diff --git a/src/Modules/CalcPerform.lua b/src/Modules/CalcPerform.lua
index 84673bf..6eaede6 100644
--- a/src/Modules/CalcPerform.lua
+++ b/src/Modules/CalcPerform.lua
@@ -2240,6 +2240,14 @@ function calcs.perform(env, skipEHP)
 							inc = inc + skillModList:Sum("INC", skillCfg, "ArchonBuffEffect")
 						end
 						local more = modStore:More(skillCfg, "BuffEffect", "BuffEffectOnSelf") * calcLib.mod(modStore, skillCfg, "Magnitude")
+						if activeSkill.activeEffect.grantedEffect.name == "Ghost Dance" then
+							-- One Shroud per repeat interval (Cooldown Recovery applies), lost on the next Hit, regeneration for "Recently" (4 s) after each loss
+							output.GhostShroudInterval = calcSkillCooldown(skillModList, skillCfg, activeSkill.skillData)
+							output.GhostDanceUptime = m_min(1, 4 / m_max(output.GhostShroudInterval, 0.001))
+							if modDB:Flag(nil, "GhostDanceAverageUptime") then
+								more = more * output.GhostDanceUptime
+							end
+						end
 						srcList:ScaleAddList(buff.modList, (1 + inc / 100) * more)
 						mergeBuff(srcList, buffs, buff.name)
 						if activeSkill.skillData.thisIsNotABuff then
diff --git a/src/Modules/ConfigOptions.lua b/src/Modules/ConfigOptions.lua
index 9fef332..7883e07 100644
--- a/src/Modules/ConfigOptions.lua
+++ b/src/Modules/ConfigOptions.lua
@@ -249,6 +249,10 @@ local configSettings = {
 	{ var = "conditionLostGhostShroudRecently", type = "check", label = "Have you lost a Ghost Shroud Recently?", ifSkill = "Ghost Dance", tooltip = "Ghost Dance regenerates Energy Shield equal to 2% of your Evasion Rating per second while you have lost a Ghost Shroud Recently. You gain a Shroud about every 10 to 12 seconds (maximum 3) and lose one when you are Hit.", apply = function(val, modList, enemyModList)
 		modList:NewMod("Condition:LostGhostShroudRecently", "FLAG", true, "Config")
 	end },
+	{ var = "ghostDanceAverageUptime", type = "check", label = "Average it over constant Hits?", ifSkill = "Ghost Dance", tooltip = "Scales the Ghost Dance regeneration by its uptime while you are Hit faster than you gain Shrouds:\neach Shroud is lost on the next Hit and regenerates for 4 seconds (Recently), so uptime = 4 s / Shroud interval (max 100%).\nThe interval is 12 s at gem level 1 to 10.1 s at level 20; Cooldown Recovery Rate applies. Implies the option above.", apply = function(val, modList, enemyModList)
+		modList:NewMod("Condition:LostGhostShroudRecently", "FLAG", true, "Config")
+		modList:NewMod("GhostDanceAverageUptime", "FLAG", true, "Config")
+	end },
 	{ label = "Barrage:", ifSkill = "Barrage" },
 	{ var = "barrageEmpoweredOnly", type = "check", label = "Only count the Empowered Attack (burst)?", ifSkill = "Barrage", tooltip = "By default the repeats of the one Empowered Attack are averaged over Barrage's cooldown (2 seconds plus a share of the empowered skill's attack time, minus the time spent casting Barrage).\nTick this to show the damage of the Empowered Attack alone." },
 	{ label = "Frost Bomb:", ifSkill = "Frost Bomb" },
